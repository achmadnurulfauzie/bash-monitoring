[Unit]
Description=System Monitoring Timer
Documentation=man:monitoring(8)
Requires=system-monitor.service

[Timer]
# Jalankan setiap 5 menit
OnBootSec=1min
OnUnitActiveSec=5min
# Randomize eksekusi dalam 0-30 detik untuk menghindari spike
RandomizedDelaySec=30sec
Persistent=true

[Install]
WantedBy=timers.target

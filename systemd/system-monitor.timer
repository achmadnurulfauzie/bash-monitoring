[Unit]
Description=System Monitoring Timer
Documentation=man:monitoring(8)
Requires=system-monitor.service

[Timer]
# Run every 5 minutes
OnBootSec=1min
OnUnitActiveSec=5min
# Randomize execution within 0-30 seconds to avoid spike
RandomizedDelaySec=30sec
Persistent=true

[Install]
WantedBy=timers.target

# ==================== KONFIGURASI MONITORING ====================
# File konfigurasi untuk System Monitoring Script

# ==================== NOTIFIKASI ====================
# Pilihan: telegram, google_chat, both
NOTIFICATION_TYPE=telegram

# ==================== TELEGRAM CONFIGURATION ====================
# Dapatkan BOT_TOKEN dari @BotFather di Telegram
# Dapatkan CHAT_ID dari @userinfobot atau forward pesan ke bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==================== GOOGLE CHAT CONFIGURATION ====================
# Dapatkan webhook URL dari Google Chat space > Apps & integrations > Incoming webhooks
GOOGLE_CHAT_WEBHOOK_URL=""

# ==================== THRESHOLD KONFIGURASI ====================
# Persentase (0-100) di mana alert akan dikirim
CPU_THRESHOLD=40
MEMORY_THRESHOLD=40
DISK_THRESHOLD=40

# ==================== ALERT TITLE ====================
# Judul yang akan ditampilkan di alert message
# Contoh: PROD-SERVER-01, dsb
ALERT_TITLE="PROD-SERVER"

# ==================== DEBUG MODE ====================
# Set ke "true" untuk enable debug logging
DEBUG=false

# ==================== MONITORING CONFIGURATION ====================
# Configuration file for System Monitoring Script

# ==================== NOTIFICATIONS ====================
# Options: telegram, google_chat, both
NOTIFICATION_TYPE=telegram

# ==================== TELEGRAM CONFIGURATION ====================
# Get BOT_TOKEN from @BotFather on Telegram
# Get CHAT_ID from @userinfobot or forward message to your bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==================== GOOGLE CHAT CONFIGURATION ====================
# Get webhook URL from Google Chat space > Apps & integrations > Incoming webhooks
GOOGLE_CHAT_WEBHOOK_URL=""

# ==================== THRESHOLD CONFIGURATION ====================
# Percentage (0-100) at which alerts will be sent
CPU_THRESHOLD=40
MEMORY_THRESHOLD=40
DISK_THRESHOLD=40

# ==================== ALERT TITLE ====================
# Title that will be displayed in alert message
# Example: PROD-SERVER-01, etc.
ALERT_TITLE="PROD-SERVER"

# ==================== DEBUG MODE ====================
# Set to "true" to enable debug logging
DEBUG=false
